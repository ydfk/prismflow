# 将 example.com 替换为统一域名，合并到现有 Caddyfile。
# Caddy 与 PrismFlow 必须能访问同一个宿主机回环地址；容器 Caddy 可使用 host 网络。
example.com {
    # 可选：仅在启用反代 TLS 的 XHTTP 后，添加面板生成的对应 handle 规则。
    # @xhttp path /replace-with-entry-path /replace-with-entry-path/*
    # handle @xhttp {
    #     reverse_proxy 127.0.0.1:23456 {
    #         flush_interval -1
    #     }
    # }
    handle {
        reverse_proxy 127.0.0.1:8081
    }
}
# /              伪装网站
# /manage/       管理面板（可在面板修改管理路径）
# /s/令牌        用户订阅
# REALITY / AnyTLS / Hysteria2 仍直连各自的 TCP/UDP 端口。
# 若通过面板申请 HTTP-01 证书，将验证路径合并到对应 HTTP 站点。
# http://example.com {
#     handle /.well-known/acme-challenge/* {
#         reverse_proxy 127.0.0.1:8081
#     }
#     handle {
#         redir https://{host}{uri} 308
#     }
# }
